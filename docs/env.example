# Paper Alpaca only. Never commit real keys.
VOL10S_PAPER_PORT=8977
VOL10S_BIND=127.0.0.1
VOL10S_ARMED=false

VOL10S_ALPACA_BASE_URL=https://paper-api.alpaca.markets
VOL10S_ALPACA_DATA_URL=https://data.alpaca.markets
VOL10S_ALPACA_KEY=
VOL10S_ALPACA_SECRET=

# Optional dedicated market-data key (SIP/OPRA). Trading stays on VOL10S_ALPACA_*.
# VOL10S_DATA_ALPACA_KEY=
# VOL10S_DATA_ALPACA_SECRET=

# Alpaca CLI (read-only account/position sync + agent tool)
VOL10S_ALPACA_CLI=true
# VOL10S_ALPACA_CLI_BIN=alpaca

# LLM — plug in any model. Convexity's hosted desk uses Ollama Cloud (custom).
# Local Ollama:
#   VOL10S_LLM_PROVIDER=ollama
#   VOL10S_LLM_BASE_URL=http://127.0.0.1:11434
#   VOL10S_LLM_MODEL=llama3.1
# Ollama Cloud:
#   VOL10S_LLM_PROVIDER=ollama
#   VOL10S_LLM_BASE_URL=https://ollama.com
#   VOL10S_LLM_API_KEY=
#   VOL10S_LLM_MODEL=your-custom-model
# OpenAI-compatible (OpenAI, Groq, Featherless, OpenRouter, …):
#   VOL10S_LLM_PROVIDER=openai
#   VOL10S_LLM_BASE_URL=https://api.openai.com
#   VOL10S_LLM_API_KEY=
#   VOL10S_LLM_MODEL=gpt-4o-mini
VOL10S_LLM_PROVIDER=ollama
VOL10S_LLM_BASE_URL=http://127.0.0.1:11434
VOL10S_LLM_MODEL=llama3.1
VOL10S_LLM_API_KEY=

# Optional: swap bundled rankers
# VOL10S_XGB_MODEL=./src/services/ml/xgbModel.json
# VOL10S_NTSM_MODEL=./src/services/ml/ntsmModel.json

# Public desk admin (httpOnly cookie). Leave blank to disable login.
VOL10S_ADMIN_PASSWORD=
VOL10S_ADMIN_SECRET=
